{
  "name": "@caudex-workout/engine",
  "version": "0.1.0",
  "description": "Deterministic exercise-programming and active-workout tracking SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caudex-workout/engine.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canonical": {
      "types": "./dist/canonical.d.ts",
      "import": "./dist/canonical.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./methodologies": {
      "types": "./dist/methodologies/index.d.ts",
      "import": "./dist/methodologies/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./schema/canonical": "./schemas/v0/canonical.schema.json",
    "./schema/recommendation-request": "./schemas/v0/recommendation-request.schema.json",
    "./schema/recommendation-result": "./schemas/v0/recommendation-result.schema.json",
    "./schema/evaluation-request": "./schemas/v0/evaluation-request.schema.json",
    "./schema/evaluation-result": "./schemas/v0/evaluation-result.schema.json",
    "./schema/execution-request": "./schemas/operations/v1/execution-request.schema.json",
    "./schema/discovery": "./schemas/discovery/v1/discovery.schema.json",
    "./schema/portable": "./schemas/portable/v1/portable.schema.json",
    "./schema/double-progression-config": "./schemas/methodologies/double-progression-config-v1.schema.json",
    "./schema/double-progression-state": "./schemas/methodologies/double-progression-state-v1.schema.json",
    "./schema/rpe-top-set-backoff-config": "./schemas/methodologies/rpe-top-set-backoff-config-v1.schema.json",
    "./schema/rpe-top-set-backoff-state": "./schemas/methodologies/rpe-top-set-backoff-state-v1.schema.json"
  },
  "files": [
    "dist/",
    "wasm/",
    "schemas/",
    "fixtures/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.3",
    "rollup": "4.62.4",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "node scripts/build-package.mjs"
  }
}
