{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caudex.dev/schemas/methodologies/double-progression-config-v1.schema.json",
  "title": "Caudex double-progression configuration v1",
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 200 },
    "decimal": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
    "measurement": {
      "type": "object",
      "required": ["amount", "unit"],
      "properties": {
        "amount": { "$ref": "#/$defs/decimal" },
        "unit": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "repRange": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "max": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": false
    },
    "advancementCriteria": {
      "type": "object",
      "required": ["minimumSuccessfulSets", "minimumRepetitions"],
      "properties": {
        "minimumSuccessfulSets": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "minimumRepetitions": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": false
    },
    "failurePolicy": {
      "type": "object",
      "required": ["onPartial", "onFailure", "regressionAmount"],
      "properties": {
        "onPartial": { "enum": ["hold", "regress"] },
        "onFailure": { "enum": ["hold", "regress"] },
        "regressionAmount": { "$ref": "#/$defs/measurement" }
      },
      "additionalProperties": false
    },
    "rounding": {
      "type": "object",
      "required": ["mode", "quantum"],
      "properties": {
        "mode": { "enum": ["nearest", "up", "down"] },
        "quantum": { "$ref": "#/$defs/measurement" }
      },
      "additionalProperties": false
    },
    "exerciseOverride": {
      "type": "object",
      "required": ["exerciseId"],
      "properties": {
        "exerciseId": { "$ref": "#/$defs/identifier" },
        "repRange": { "$ref": "#/$defs/repRange" },
        "workingSets": { "type": "integer", "minimum": 1, "maximum": 64 },
        "advancementCriteria": { "$ref": "#/$defs/advancementCriteria" },
        "initialLoad": { "$ref": "#/$defs/measurement" },
        "loadIncrement": { "$ref": "#/$defs/measurement" },
        "failurePolicy": { "$ref": "#/$defs/failurePolicy" },
        "rounding": { "$ref": "#/$defs/rounding" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "repRange",
    "workingSets",
    "advancementCriteria",
    "initialLoad",
    "loadIncrement",
    "failurePolicy",
    "rounding"
  ],
  "properties": {
    "repRange": { "$ref": "#/$defs/repRange" },
    "workingSets": { "type": "integer", "minimum": 1, "maximum": 64 },
    "advancementCriteria": { "$ref": "#/$defs/advancementCriteria" },
    "initialLoad": { "$ref": "#/$defs/measurement" },
    "loadIncrement": { "$ref": "#/$defs/measurement" },
    "failurePolicy": { "$ref": "#/$defs/failurePolicy" },
    "rounding": { "$ref": "#/$defs/rounding" },
    "exerciseOverrides": {
      "type": "array",
      "items": { "$ref": "#/$defs/exerciseOverride" }
    }
  },
  "additionalProperties": false
}
