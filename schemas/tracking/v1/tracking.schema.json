{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caudex.dev/schemas/tracking/v1/tracking.schema.json",
  "title": "Caudex canonical tracking protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/commandRequest" },
    { "$ref": "#/$defs/atomicBatchRequest" },
    { "$ref": "#/$defs/commandResult" },
    { "$ref": "#/$defs/atomicBatchResult" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "timestamp": { "type": "string", "format": "date-time", "maxLength": 64 },
    "decimal": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$", "maxLength": 40 },
    "scope": {
      "type": "object",
      "required": ["hostScopeKey"],
      "properties": {
        "hostScopeKey": { "$ref": "#/$defs/id" },
        "athleteId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["commandId", "occurredAt"],
      "properties": {
        "commandId": { "$ref": "#/$defs/id" },
        "occurredAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["amount", "unit"],
      "properties": {
        "amount": { "$ref": "#/$defs/decimal" },
        "unit": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["code", "value"],
      "properties": {
        "code": { "$ref": "#/$defs/id" },
        "value": { "$ref": "#/$defs/measurement" }
      },
      "additionalProperties": false
    },
    "set": {
      "type": "object",
      "required": ["id", "kind", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/id" },
        "targetMetrics": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/metric" } },
        "actualMetrics": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/metric" } },
        "status": { "enum": ["open", "completed", "partial", "failed", "skipped"] },
        "recordedAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "membership": {
      "type": "object",
      "required": ["id", "exerciseId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "exerciseId": { "$ref": "#/$defs/id" },
        "sets": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/set" } }
      },
      "additionalProperties": false
    },
    "workout": {
      "type": "object",
      "required": ["id", "scope", "revision", "status", "startedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "scope": { "$ref": "#/$defs/scope" },
        "revision": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["active", "completed", "cancelled"] },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": { "$ref": "#/$defs/timestamp" },
        "exercises": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/membership" } },
        "origin": { "enum": ["manual", "template", "recommendation"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "prescription": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/prescribedExercise" } }
      },
      "additionalProperties": false
    },
    "prescribedSet": {
      "type": "object",
      "required": ["setId", "kind"],
      "properties": {
        "setId": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/id" },
        "targetMetrics": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/metric" } }
      },
      "additionalProperties": false
    },
    "prescribedExercise": {
      "type": "object",
      "required": ["membershipId", "exerciseId"],
      "properties": {
        "membershipId": { "$ref": "#/$defs/id" },
        "exerciseId": { "$ref": "#/$defs/id" },
        "sets": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/prescribedSet" } },
        "notes": { "type": "string", "maxLength": 2000 },
        "tags": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": false
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object", "required": ["recommendation"], "additionalProperties": false,
          "properties": { "recommendation": {
            "type": "object", "required": ["acceptedRecommendationId", "inputFingerprint", "resultFingerprint", "methodologyId", "methodologyVersion", "methodologyConfigVersion"],
            "properties": {
              "acceptedRecommendationId": { "$ref": "#/$defs/id" },
              "inputFingerprint": { "type": "string", "maxLength": 200 },
              "resultFingerprint": { "type": "string", "maxLength": 200 },
              "methodologyId": { "$ref": "#/$defs/id" },
              "methodologyVersion": { "type": "string", "maxLength": 100 },
              "methodologyConfigVersion": { "type": "integer", "minimum": 0 },
              "methodologyStateRevision": { "type": "string", "maxLength": 200 },
              "methodologyStateFingerprint": { "type": "string", "maxLength": 200 }
            }, "additionalProperties": false
          } }
        },
        {
          "type": "object", "required": ["template"], "additionalProperties": false,
          "properties": { "template": {
            "type": "object", "required": ["templateId", "templateRevision"],
            "properties": { "templateId": { "$ref": "#/$defs/id" }, "templateRevision": { "type": "integer", "minimum": 0 } },
            "additionalProperties": false
          } }
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "workouts": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/workout" } },
        "startReceipts": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/startReceipt" } }
      },
      "additionalProperties": false
    },
    "startReceipt": {
      "type": "object",
      "required": ["command", "disposition", "workout"],
      "properties": {
        "command": { "type": "object" },
        "disposition": { "enum": ["applied", "replayed"] },
        "workout": { "$ref": "#/$defs/workout" }
      },
      "additionalProperties": false
    },
    "anchor": {
      "oneOf": [
        { "type": "string", "enum": ["beginning", "end"] },
        { "type": "object", "required": ["before"], "properties": { "before": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
        { "type": "object", "required": ["after"], "properties": { "after": { "$ref": "#/$defs/id" } }, "additionalProperties": false }
      ]
    },
    "command": {
      "oneOf": [
        { "type": "object", "required": ["startWorkout"], "properties": { "startWorkout": { "$ref": "#/$defs/startWorkout" } }, "additionalProperties": false },
        { "type": "object", "required": ["addExercise"], "properties": { "addExercise": { "$ref": "#/$defs/addExercise" } }, "additionalProperties": false },
        { "type": "object", "required": ["removeExercise"], "properties": { "removeExercise": { "$ref": "#/$defs/membershipRevision" } }, "additionalProperties": false },
        { "type": "object", "required": ["reorderExercise"], "properties": { "reorderExercise": { "$ref": "#/$defs/reorderExercise" } }, "additionalProperties": false },
        { "type": "object", "required": ["addSet"], "properties": { "addSet": { "$ref": "#/$defs/addSet" } }, "additionalProperties": false },
        { "type": "object", "required": ["completeSet"], "properties": { "completeSet": { "$ref": "#/$defs/completeSet" } }, "additionalProperties": false },
        { "type": "object", "required": ["skipSet"], "properties": { "skipSet": { "$ref": "#/$defs/timedSet" } }, "additionalProperties": false },
        { "type": "object", "required": ["reopenSet"], "properties": { "reopenSet": { "$ref": "#/$defs/setRevision" } }, "additionalProperties": false },
        { "type": "object", "required": ["removeSet"], "properties": { "removeSet": { "$ref": "#/$defs/setRevision" } }, "additionalProperties": false },
        { "type": "object", "required": ["reorderSet"], "properties": { "reorderSet": { "$ref": "#/$defs/reorderSet" } }, "additionalProperties": false },
        { "type": "object", "required": ["completeWorkout"], "properties": { "completeWorkout": { "$ref": "#/$defs/completeWorkout" } }, "additionalProperties": false }
      ]
    },
    "startWorkout": {
      "type": "object", "required": ["metadata", "scope", "workoutId", "startedAt"],
      "properties": { "metadata": { "$ref": "#/$defs/metadata" }, "scope": { "$ref": "#/$defs/scope" }, "workoutId": { "$ref": "#/$defs/id" }, "startedAt": { "$ref": "#/$defs/timestamp" } }, "additionalProperties": false
    },
    "workoutRevisionProperties": {
      "type": "object", "required": ["metadata", "scope", "workoutId", "expectedRevision"],
      "properties": { "metadata": { "$ref": "#/$defs/metadata" }, "scope": { "$ref": "#/$defs/scope" }, "workoutId": { "$ref": "#/$defs/id" }, "expectedRevision": { "type": "integer", "minimum": 0 } }
    },
    "membershipRevision": {
      "allOf": [
        { "$ref": "#/$defs/workoutRevisionProperties" },
        { "type": "object", "required": ["membershipId"], "properties": { "membershipId": { "$ref": "#/$defs/id" } }, "additionalProperties": true }
      ], "unevaluatedProperties": false
    },
    "setRevision": {
      "allOf": [
        { "$ref": "#/$defs/membershipRevision" },
        { "type": "object", "required": ["setId"], "properties": { "setId": { "$ref": "#/$defs/id" } }, "additionalProperties": true }
      ], "unevaluatedProperties": false
    },
    "addExercise": {
      "allOf": [ { "$ref": "#/$defs/membershipRevision" }, { "type": "object", "required": ["exerciseId", "anchor"], "properties": { "exerciseId": { "$ref": "#/$defs/id" }, "anchor": { "$ref": "#/$defs/anchor" } } } ], "unevaluatedProperties": false
    },
    "reorderExercise": {
      "allOf": [ { "$ref": "#/$defs/membershipRevision" }, { "type": "object", "required": ["anchor"], "properties": { "anchor": { "$ref": "#/$defs/anchor" } } } ], "unevaluatedProperties": false
    },
    "addSet": {
      "allOf": [ { "$ref": "#/$defs/setRevision" }, { "type": "object", "required": ["kind", "anchor"], "properties": { "kind": { "$ref": "#/$defs/id" }, "targetMetrics": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/metric" } }, "anchor": { "$ref": "#/$defs/anchor" } } } ], "unevaluatedProperties": false
    },
    "completeSet": {
      "allOf": [ { "$ref": "#/$defs/setRevision" }, { "type": "object", "required": ["actualMetrics", "completedAt"], "properties": { "actualMetrics": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/metric" } }, "status": { "enum": ["completed", "partial", "failed"] }, "completedAt": { "$ref": "#/$defs/timestamp" } } } ], "unevaluatedProperties": false
    },
    "timedSet": {
      "allOf": [ { "$ref": "#/$defs/setRevision" }, { "type": "object", "required": ["at"], "properties": { "at": { "$ref": "#/$defs/timestamp" } } } ], "unevaluatedProperties": false
    },
    "reorderSet": {
      "allOf": [ { "$ref": "#/$defs/setRevision" }, { "type": "object", "required": ["anchor"], "properties": { "anchor": { "$ref": "#/$defs/anchor" } } } ], "unevaluatedProperties": false
    },
    "completeWorkout": {
      "allOf": [ { "$ref": "#/$defs/workoutRevisionProperties" }, { "type": "object", "required": ["completedAt"], "properties": { "completedAt": { "$ref": "#/$defs/timestamp" } } } ], "unevaluatedProperties": false
    },
    "issue": {
      "type": "object",
      "required": ["code", "category", "severity", "message"],
      "properties": {
        "code": { "type": "string", "maxLength": 200 },
        "category": { "enum": ["validation", "not_found", "conflict"] },
        "severity": { "enum": ["warning", "error"] },
        "path": { "type": "string", "maxLength": 500 },
        "message": { "type": "string", "maxLength": 1000 },
        "relatedIds": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": false
    },
    "outcome": {
      "oneOf": [
        { "type": "object", "required": ["accepted"], "properties": { "accepted": { "$ref": "#/$defs/accepted" } }, "additionalProperties": false },
        { "type": "object", "required": ["rejected"], "properties": { "rejected": { "$ref": "#/$defs/rejected" } }, "additionalProperties": false }
      ]
    },
    "accepted": {
      "type": "object",
      "required": ["commandId", "disposition", "workout"],
      "properties": {
        "commandId": { "$ref": "#/$defs/id" },
        "disposition": { "enum": ["applied", "replayed"] },
        "workout": { "$ref": "#/$defs/workout" },
        "warnings": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/issue" } }
      },
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "required": ["commandId", "issues"],
      "properties": {
        "commandId": { "$ref": "#/$defs/id" },
        "issues": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/issue" } }
      },
      "additionalProperties": false
    },
    "commandRequest": {
      "type": "object",
      "required": ["schemaVersion", "snapshot", "command"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "snapshot": { "$ref": "#/$defs/snapshot" },
        "command": { "$ref": "#/$defs/command" }
      },
      "additionalProperties": false
    },
    "atomicBatchRequest": {
      "type": "object",
      "required": ["schemaVersion", "snapshot", "commands"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "snapshot": { "$ref": "#/$defs/snapshot" },
        "commands": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/command" } }
      },
      "additionalProperties": false
    },
    "commandResult": {
      "type": "object",
      "required": ["schemaVersion", "outcome"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "outcome": { "$ref": "#/$defs/outcome" }
      },
      "additionalProperties": false
    },
    "atomicBatchResult": {
      "type": "object",
      "required": ["schemaVersion", "applied", "outcomes", "snapshot"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "applied": { "type": "boolean" },
        "outcomes": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/outcome" } },
        "snapshot": { "$ref": "#/$defs/snapshot" },
        "issues": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/issue" } }
      },
      "additionalProperties": false
    }
  }
}
