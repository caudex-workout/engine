{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caudex.dev/schemas/templates/v1/workout-template.schema.json",
  "title": "Caudex workout template v1",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "exercises", "revision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "exercises": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "required": ["exerciseId"],
        "properties": {
          "exerciseId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "sets": {
            "type": "array", "maxItems": 256,
            "items": {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "minLength": 1, "maxLength": 200 },
                "targetMetrics": {
                  "type": "array", "maxItems": 32,
                  "items": {
                    "type": "object", "required": ["code", "value"],
                    "properties": {
                      "code": { "type": "string", "minLength": 1, "maxLength": 200 },
                      "value": {
                        "type": "object", "required": ["amount", "unit"],
                        "properties": {
                          "amount": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
                          "unit": { "type": "string", "minLength": 1, "maxLength": 200 }
                        }, "additionalProperties": false
                      }
                    }, "additionalProperties": false
                  }
                }
              }, "additionalProperties": false
            }
          },
          "notes": { "type": "string", "maxLength": 2000 },
          "tags": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
        }, "additionalProperties": false
      }
    },
    "notes": { "type": "string", "maxLength": 2000 },
    "tags": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "revision": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}

