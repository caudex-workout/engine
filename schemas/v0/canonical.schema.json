{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caudex.dev/schemas/v0/canonical.schema.json",
  "title": "Caudex canonical v0 messages",
  "anyOf": [
    { "$ref": "#/$defs/recommendationRequest" },
    { "$ref": "#/$defs/evaluationRequest" },
    { "$ref": "#/$defs/recommendationResult" },
    { "$ref": "#/$defs/evaluationResult" },
    { "$ref": "#/$defs/programDefinitionDocument" },
    { "$ref": "#/$defs/programInstanceDocument" },
    { "$ref": "#/$defs/programPlanningState" },
    { "$ref": "#/$defs/programOccurrenceRecord" },
    { "$ref": "#/$defs/plannedSessionIntentDocument" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 200
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(|/(?:[^~/]|~[01])*)*$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "openObject": {
      "type": "object"
    },
    "measurement": {
      "type": "object",
      "required": ["amount", "unit"],
      "properties": {
        "amount": { "$ref": "#/$defs/decimal" },
        "unit": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["code", "value"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "value": { "$ref": "#/$defs/measurement" }
      },
      "additionalProperties": false
    },
    "muscleContribution": {
      "type": "object",
      "required": ["muscleId", "role"],
      "properties": {
        "muscleId": { "$ref": "#/$defs/identifier" },
        "role": {
          "enum": ["primary", "secondary", "stabilizer", "custom"]
        },
        "weight": { "$ref": "#/$defs/decimal" }
      },
      "additionalProperties": false
    },
    "knowledgeAuthority": {
      "enum": ["source_provided", "caudex_curated", "mechanically_derived", "host_provided", "unknown"]
    },
    "knowledgeConfidence": {
      "enum": ["low", "moderate", "high", "unknown"]
    },
    "knowledgeEvidence": {
      "type": "object",
      "required": ["authority"],
      "properties": {
        "authority": { "$ref": "#/$defs/knowledgeAuthority" },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 200 },
        "confidence": { "$ref": "#/$defs/knowledgeConfidence" }
      },
      "additionalProperties": false
    },
    "equipmentRequirement": {
      "type": "object",
      "required": ["equipmentId"],
      "properties": {
        "equipmentId": { "$ref": "#/$defs/identifier" },
        "equipmentFamilyId": { "$ref": "#/$defs/identifier" },
        "requirement": { "enum": ["required", "optional", "one_of"] },
        "role": { "enum": ["load_bearing", "support", "setup", "other"] },
        "alternativeGroup": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "trackingDimension": {
      "type": "object",
      "required": ["metricCode"],
      "properties": {
        "metricCode": { "$ref": "#/$defs/identifier" },
        "requirement": { "enum": ["required", "optional"] },
        "scope": { "enum": ["total", "per_side", "per_hand", "left_right_independent"] }
      },
      "additionalProperties": false
    },
    "progressionCapabilities": {
      "type": "object",
      "properties": {
        "externalLoad": { "type": "boolean" },
        "repetitions": { "type": "boolean" },
        "percentageOneRepMax": { "type": "boolean" },
        "effortTarget": { "type": "boolean" },
        "amrap": { "type": "boolean" },
        "failureTraining": { "type": "boolean" },
        "duration": { "type": "boolean" },
        "distance": { "type": "boolean" },
        "assistanceReduction": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "exerciseRelationships": {
      "type": "object",
      "properties": {
        "variantOf": { "$ref": "#/$defs/identifier" },
        "variantIds": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "substituteIds": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "similarExerciseIds": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "sharedProgressionStateIds": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "exerciseVariantDimension": {
      "type": "object",
      "required": ["dimension", "value"],
      "properties": {
        "dimension": { "$ref": "#/$defs/identifier" },
        "value": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "exerciseFatigue": {
      "type": "object",
      "properties": {
        "localMuscular": { "enum": ["low", "moderate", "high", "unknown"] },
        "axial": { "enum": ["low", "moderate", "high", "unknown"] },
        "systemic": { "enum": ["low", "moderate", "high", "unknown"] },
        "grip": { "enum": ["low", "moderate", "high", "unknown"] },
        "cardiorespiratory": { "enum": ["low", "moderate", "high", "unknown"] },
        "technical": { "enum": ["low", "moderate", "high", "unknown"] }
      },
      "additionalProperties": false
    },
    "exerciseKnowledge": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "familyId": { "$ref": "#/$defs/identifier" },
        "variantDimensions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/exerciseVariantDimension" }, "uniqueItems": true },
        "movementPatterns": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "structuralType": { "enum": ["compound", "isolation", "isometric", "locomotor", "conditioning", "mobility", "other"] },
        "laterality": { "enum": ["bilateral", "unilateral", "alternating", "independent_bilateral", "not_applicable", "unknown"] },
        "repetitionSemantics": { "enum": ["total", "per_side", "alternating_total", "left_right_independent", "not_applicable", "unknown"] },
        "equipmentRequirements": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/equipmentRequirement" } },
        "trackingDimensions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/trackingDimension" } },
        "loadingMode": { "enum": ["external_load", "bodyweight", "bodyweight_plus_load", "assisted_bodyweight", "repetitions_only", "duration", "distance", "load_duration", "distance_duration", "machine_load", "other"] },
        "progressionCapabilities": { "$ref": "#/$defs/progressionCapabilities" },
        "restrictionTags": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "relationships": { "$ref": "#/$defs/exerciseRelationships" },
        "skillLevel": { "enum": ["beginner_friendly", "intermediate", "advanced_technical", "highly_technical", "unknown"] },
        "stabilityDemand": { "enum": ["externally_stabilized", "supported", "free", "highly_unstable", "unknown"] },
        "setupBurden": { "enum": ["trivial", "low", "moderate", "high", "unknown"] },
        "fatigue": { "$ref": "#/$defs/exerciseFatigue" },
        "evidence": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/knowledgeEvidence" } }
      },
      "additionalProperties": false
    },
    "exercise": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string" },
        "equipmentIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "movementTags": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "muscleContributions": {
          "type": "array",
          "items": { "$ref": "#/$defs/muscleContribution" }
        },
        "unilateral": { "type": "boolean" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "attributes": { "$ref": "#/$defs/openObject" },
        "knowledge": { "$ref": "#/$defs/exerciseKnowledge" }
      },
      "additionalProperties": false
    },
    "muscleEmphasis": {
      "type": "object",
      "required": ["muscleId", "weight"],
      "properties": {
        "muscleId": { "$ref": "#/$defs/identifier" },
        "weight": { "$ref": "#/$defs/decimal" }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "subjectId": { "$ref": "#/$defs/identifier" },
        "details": { "$ref": "#/$defs/openObject" }
      },
      "additionalProperties": false
    },
    "athleteProfile": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 0 },
        "displayName": { "type": "string" },
        "goals": { "$ref": "#/$defs/goalSet" },
        "experience": { "$ref": "#/$defs/experience" },
        "schedule": { "$ref": "#/$defs/schedulePreference" },
        "duration": { "$ref": "#/$defs/durationPreference" },
        "units": { "$ref": "#/$defs/unitPreferences" },
        "exercisePreferences": { "type": "array", "items": { "$ref": "#/$defs/preference" } },
        "musclePriorities": { "type": "array", "items": { "$ref": "#/$defs/musclePriority" } },
        "restrictions": { "type": "array", "items": { "$ref": "#/$defs/restriction" } },
        "locations": { "type": "array", "items": { "$ref": "#/$defs/trainingLocation" } },
        "capabilityObservations": { "type": "array", "items": { "$ref": "#/$defs/capabilityObservation" } },
        "metadata": { "$ref": "#/$defs/openObject" }
      },
      "additionalProperties": false
    },
    "goalSet": { "type": "object", "properties": { "primary": { "$ref": "#/$defs/goal" }, "secondary": { "type": "array", "items": { "$ref": "#/$defs/goal" } }, "bodyCompositionObjective": { "type": "string" } }, "additionalProperties": false },
    "goal": { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "#/$defs/identifier" }, "weight": { "type": "integer", "minimum": 0, "maximum": 1000 } }, "additionalProperties": false },
    "experience": { "type": "object", "properties": { "resistanceTraining": { "enum": ["novice", "intermediate", "advanced"] }, "consistentMonths": { "type": "integer", "minimum": 0, "maximum": 65535 }, "technicalLiftFamiliarity": { "enum": ["unfamiliar", "learning", "familiar", "proficient"] }, "exercises": { "type": "array", "items": { "type": "object", "required": ["exerciseId", "familiarity"], "properties": { "exerciseId": { "$ref": "#/$defs/identifier" }, "familiarity": { "enum": ["unfamiliar", "learning", "familiar", "proficient"] } }, "additionalProperties": false } } }, "additionalProperties": false },
    "schedulePreference": { "type": "object", "properties": { "preferredSessionsPerWeek": { "type": "integer", "minimum": 0, "maximum": 7 }, "minimumSessionsPerWeek": { "type": "integer", "minimum": 0, "maximum": 7 }, "maximumSessionsPerWeek": { "type": "integer", "minimum": 0, "maximum": 7 }, "preferredDays": { "type": "array", "items": { "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] }, "uniqueItems": true }, "cadence": { "enum": ["unspecified", "fixed_weekdays", "rolling"] }, "preferRestBetweenSessions": { "type": "boolean" } }, "additionalProperties": false },
    "durationPreference": { "type": "object", "properties": { "preferredMinutes": { "type": "integer", "minimum": 0, "maximum": 65535 }, "acceptableMinimumMinutes": { "type": "integer", "minimum": 0, "maximum": 65535 }, "acceptableMaximumMinutes": { "type": "integer", "minimum": 0, "maximum": 65535 }, "hardMaximumMinutes": { "type": "integer", "minimum": 0, "maximum": 65535 } }, "additionalProperties": false },
    "unitPreferences": { "type": "object", "properties": { "load": { "enum": ["kilograms", "pounds"] }, "bodyweight": { "enum": ["kilograms", "pounds"] }, "distance": { "enum": ["meters", "kilometers", "feet", "miles"] } }, "additionalProperties": false },
    "capabilityObservation": { "type": "object", "required": ["id", "kind", "observedAt"], "properties": { "id": { "$ref": "#/$defs/identifier" }, "kind": { "enum": ["recent_performance", "estimated_one_rep_max", "assistance_capacity", "exercise_familiarity", "benchmark", "custom"] }, "exerciseId": { "$ref": "#/$defs/identifier" }, "value": { "$ref": "#/$defs/measurement" }, "observedAt": { "$ref": "#/$defs/timestamp" }, "provenance": { "enum": ["athlete_reported", "host_observed", "device_supplied", "imported", "unknown"] }, "customKindId": { "$ref": "#/$defs/identifier" } }, "additionalProperties": false },
    "readinessObservation": { "type": "object", "required": ["id", "dimension", "value", "scaleMaximum", "observedAt"], "properties": { "id": { "$ref": "#/$defs/identifier" }, "dimension": { "enum": ["overall", "fatigue", "sleep_quality", "pain", "soreness"] }, "subjectId": { "$ref": "#/$defs/identifier" }, "value": { "type": "integer", "minimum": 0, "maximum": 255 }, "scaleMaximum": { "type": "integer", "minimum": 1, "maximum": 255 }, "observedAt": { "$ref": "#/$defs/timestamp" }, "provenance": { "enum": ["athlete_reported", "host_observed", "device_supplied", "imported", "unknown"] } }, "additionalProperties": false },
    "preference": { "type": "object", "required": ["targetKind", "targetId", "level"], "properties": { "targetKind": { "enum": ["exercise", "exercise_family", "movement_pattern", "equipment_category"] }, "targetId": { "$ref": "#/$defs/identifier" }, "level": { "enum": ["preferred", "deprioritized", "excluded", "required"] } }, "additionalProperties": false },
    "musclePriority": { "type": "object", "required": ["muscleId", "priority"], "properties": { "muscleId": { "$ref": "#/$defs/identifier" }, "priority": { "enum": ["emphasize", "balanced", "maintain", "deprioritize"] }, "weight": { "type": "integer", "minimum": 0, "maximum": 1000 } }, "additionalProperties": false },
    "restriction": { "type": "object", "required": ["id", "targetKind", "targetId"], "properties": { "id": { "$ref": "#/$defs/identifier" }, "targetKind": { "enum": ["exercise", "exercise_family", "movement_pattern", "restriction_tag", "equipment"] }, "targetId": { "$ref": "#/$defs/identifier" } }, "additionalProperties": false },
    "trainingLocation": { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "#/$defs/identifier" }, "name": { "type": "string" }, "equipment": { "type": "array", "items": { "type": "object", "required": ["equipmentId"], "properties": { "equipmentId": { "$ref": "#/$defs/identifier" }, "minimumLoadIncrement": { "$ref": "#/$defs/measurement" } }, "additionalProperties": false } }, "metadata": { "$ref": "#/$defs/openObject" } }, "additionalProperties": false },
    "completedSet": {
      "type": "object",
      "required": ["kind", "actualMetrics", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/identifier" },
        "actualMetrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metric" }
        },
        "targetMetrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/metric" }
        },
        "completedAt": { "$ref": "#/$defs/timestamp" },
        "status": {
          "enum": ["completed", "partial", "skipped", "failed"]
        }
      },
      "additionalProperties": false
    },
    "completedExercise": {
      "type": "object",
      "required": ["exerciseId", "sets"],
      "properties": {
        "exerciseId": { "$ref": "#/$defs/identifier" },
        "sets": {
          "type": "array",
          "items": { "$ref": "#/$defs/completedSet" }
        },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "completedWorkout": {
      "type": "object",
      "required": ["id", "startedAt", "completedAt", "exercises"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": { "$ref": "#/$defs/timestamp" },
        "exercises": {
          "type": "array",
          "items": { "$ref": "#/$defs/completedExercise" }
        }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "properties": {
        "workouts": {
          "type": "array",
          "items": { "$ref": "#/$defs/completedWorkout" }
        },
        "summaries": { "$ref": "#/$defs/openObject" }
      },
      "additionalProperties": false
    },
    "trainingContext": {
      "type": "object",
      "properties": {
        "availableMinutes": { "type": "integer", "minimum": 0 },
        "hardMaximumMinutes": { "type": "integer", "minimum": 0 },
        "locationId": { "$ref": "#/$defs/identifier" },
        "equipment": { "type": "object", "properties": { "override": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true }, "additions": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true }, "removals": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true } }, "additionalProperties": false },
        "goals": { "$ref": "#/$defs/goalSet" },
        "preferences": { "type": "array", "items": { "$ref": "#/$defs/preference" } },
        "restrictions": { "type": "array", "items": { "$ref": "#/$defs/restriction" } },
        "minExercises": { "type": "integer", "minimum": 0 },
        "maxExercises": { "type": "integer", "minimum": 0 },
        "maxSets": { "type": "integer", "minimum": 0 },
        "excludedExerciseIds": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "requiredExerciseIds": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "readiness": { "type": "array", "items": { "$ref": "#/$defs/readinessObservation" } }
      },
      "additionalProperties": false
    },
    "methodologyRef": {
      "type": "object",
      "required": ["id", "configVersion", "config"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "versionRequirement": { "type": "string", "minLength": 1 },
        "configVersion": { "type": "integer", "minimum": 1 },
        "config": { "$ref": "#/$defs/openObject" }
      },
      "additionalProperties": false
    },
    "methodologyState": {
      "type": "object",
      "required": ["schemaVersion", "data"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "data": { "$ref": "#/$defs/openObject" }
      },
      "additionalProperties": false
    },
    "programStrategyRef": {
      "type": "object",
      "required": ["id", "configVersion", "config"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "versionRequirement": { "type": "string", "minLength": 1, "maxLength": 100 },
        "configVersion": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "config": true
      },
      "additionalProperties": false
    },
    "programState": {
      "type": "object",
      "required": ["schemaVersion", "data"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "data": true
      },
      "additionalProperties": false
    },
    "programTrainingContext": {
      "type": "object",
      "properties": {
        "goals": { "$ref": "#/$defs/goalSet" },
        "exercisePreferences": { "type": "array", "items": { "$ref": "#/$defs/preference" } },
        "musclePriorities": { "type": "array", "items": { "$ref": "#/$defs/musclePriority" } },
        "restrictions": { "type": "array", "items": { "$ref": "#/$defs/restriction" } },
        "requiredExerciseIds": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "excludedExerciseIds": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "progressionAssignment": {
      "type": "object",
      "required": ["stateId", "methodology"],
      "properties": {
        "stateId": { "$ref": "#/$defs/identifier" },
        "methodology": { "$ref": "#/$defs/methodologyRef" },
        "state": { "$ref": "#/$defs/methodologyState" }
      },
      "additionalProperties": false
    },
    "programExerciseSlot": {
      "type": "object",
      "required": ["slotId", "exerciseId", "progression"],
      "properties": {
        "slotId": { "$ref": "#/$defs/identifier" },
        "exerciseId": { "$ref": "#/$defs/identifier" },
        "progression": { "$ref": "#/$defs/progressionAssignment" }
      },
      "additionalProperties": false
    },
    "programPlan": {
      "type": "object",
      "required": ["strategy", "exercises"],
      "properties": {
        "strategy": { "$ref": "#/$defs/programStrategyRef" },
        "state": { "$ref": "#/$defs/programState" },
        "exercises": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/programExerciseSlot" } },
        "trainingContext": { "$ref": "#/$defs/programTrainingContext" }
      },
      "additionalProperties": false
    },
    "programDefinitionSource": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["built_in_preset", "host_custom", "imported"] },
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 }
      },
      "additionalProperties": false
    },
    "programFrequencyTarget": {
      "type": "object",
      "required": ["sessions", "days"],
      "properties": {
        "sessions": { "type": "integer", "minimum": 1, "maximum": 255 },
        "days": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": false
    },
    "programWeekdayScheduleEntry": {
      "type": "object",
      "required": ["weekday", "roleId"],
      "properties": {
        "weekday": { "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] },
        "roleId": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "programDatedScheduleEntry": {
      "type": "object",
      "required": ["localDate", "roleId"],
      "properties": {
        "localDate": { "type": "string", "format": "date" },
        "roleId": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "programSchedule": {
      "oneOf": [
        { "type": "object", "required": ["rotation"], "properties": { "rotation": { "type": "object", "required": ["roleIds"], "properties": { "roleIds": { "type": "array", "minItems": 1, "maxItems": 366, "items": { "$ref": "#/$defs/identifier" } }, "frequency": { "$ref": "#/$defs/programFrequencyTarget" } }, "additionalProperties": false } }, "additionalProperties": false },
        { "type": "object", "required": ["fixedWeekdays"], "properties": { "fixedWeekdays": { "type": "object", "required": ["entries"], "properties": { "entries": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "$ref": "#/$defs/programWeekdayScheduleEntry" } } }, "additionalProperties": false } }, "additionalProperties": false },
        { "type": "object", "required": ["frequencyTargeted"], "properties": { "frequencyTargeted": { "type": "object", "required": ["roleIds", "target"], "properties": { "roleIds": { "type": "array", "minItems": 1, "maxItems": 366, "items": { "$ref": "#/$defs/identifier" } }, "target": { "$ref": "#/$defs/programFrequencyTarget" } }, "additionalProperties": false } }, "additionalProperties": false },
        { "type": "object", "required": ["explicitDates"], "properties": { "explicitDates": { "type": "object", "required": ["entries"], "properties": { "entries": { "type": "array", "minItems": 1, "maxItems": 366, "items": { "$ref": "#/$defs/programDatedScheduleEntry" } } }, "additionalProperties": false } }, "additionalProperties": false },
        { "type": "object", "required": ["hybrid"], "properties": { "hybrid": { "type": "object", "required": ["roleIds", "target"], "properties": { "roleIds": { "type": "array", "minItems": 1, "maxItems": 366, "items": { "$ref": "#/$defs/identifier" } }, "target": { "$ref": "#/$defs/programFrequencyTarget" }, "preferredWeekdays": { "type": "array", "maxItems": 7, "items": { "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] }, "uniqueItems": true } }, "additionalProperties": false } }, "additionalProperties": false }
      ]
    },
    "programItemOrdering": {
      "type": "object",
      "properties": {
        "priorityTier": { "type": "integer", "minimum": 0, "maximum": 255 },
        "beforeItemIds": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "afterItemIds": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "programSlotRequirements": {
      "type": "object",
      "properties": {
        "targetMuscleIds": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "movementPatternIds": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "exerciseFamilyIds": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "requiredExerciseIds": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "excludedExerciseIds": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "requiredEquipmentIds": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "progressionRequirement": { "enum": ["externally_loadable_repetitions", "repetitions", "duration", "distance"] }
      },
      "additionalProperties": false
    },
    "programExercisePool": {
      "type": "object",
      "properties": {
        "exerciseIds": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
        "exerciseFamilyIds": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "programSessionItem": {
      "oneOf": [
        { "type": "object", "required": ["fixed"], "properties": { "fixed": { "type": "object", "required": ["id", "exerciseId"], "properties": { "id": { "$ref": "#/$defs/identifier" }, "exerciseId": { "$ref": "#/$defs/identifier" }, "anchor": { "enum": ["none", "preferred", "required", "block"] }, "progression": { "$ref": "#/$defs/progressionAssignment" }, "ordering": { "$ref": "#/$defs/programItemOrdering" } }, "additionalProperties": false } }, "additionalProperties": false },
        { "type": "object", "required": ["dynamic"], "properties": { "dynamic": { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "#/$defs/identifier" }, "requirements": { "$ref": "#/$defs/programSlotRequirements" }, "pool": { "$ref": "#/$defs/programExercisePool" }, "progression": { "$ref": "#/$defs/progressionAssignment" }, "ordering": { "$ref": "#/$defs/programItemOrdering" } }, "additionalProperties": false } }, "additionalProperties": false }
      ]
    },
    "programSessionRoleDefinition": {
      "type": "object",
      "required": ["id", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "items": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/programSessionItem" } },
        "defaultProgression": { "$ref": "#/$defs/progressionAssignment" },
        "musclePriorities": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/musclePriority" } },
        "expectedDurationMinutes": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "trainingContext": { "$ref": "#/$defs/programTrainingContext" },
        "configuration": true
      },
      "additionalProperties": false
    },
    "programBlockDefinition": {
      "type": "object",
      "required": ["id", "microcycleCount", "schedule", "sessionRoles"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "microcycleCount": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "phase": { "enum": ["base", "accumulation", "intensification", "realization", "deload", "custom"] },
        "phaseSemantic": { "type": "string", "minLength": 1, "maxLength": 200 },
        "schedule": { "$ref": "#/$defs/programSchedule" },
        "sessionRoles": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/programSessionRoleDefinition" } },
        "musclePriorities": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/musclePriority" } },
        "defaultProgression": { "$ref": "#/$defs/progressionAssignment" },
        "nextBlockId": { "$ref": "#/$defs/identifier" },
        "configuration": true
      },
      "additionalProperties": false
    },
    "programDefinitionReference": {
      "type": "object",
      "required": ["id", "version", "configurationFingerprint"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "configurationFingerprint": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "programDefinitionDocument": {
      "type": "object",
      "required": ["schemaVersion", "id", "version", "displayName", "strategy", "configurationFingerprint", "blocks"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "strategy": { "$ref": "#/$defs/programStrategyRef" },
        "configurationFingerprint": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source": { "$ref": "#/$defs/programDefinitionSource" },
        "blocks": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/programBlockDefinition" } }
      },
      "additionalProperties": false
    },
    "programInstanceDocument": {
      "type": "object",
      "required": ["schemaVersion", "id", "athleteId", "definition", "lifecycle", "configuration"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/identifier" },
        "athleteId": { "$ref": "#/$defs/identifier" },
        "definition": { "$ref": "#/$defs/programDefinitionReference" },
        "startedOn": { "type": "string", "format": "date" },
        "lifecycle": { "enum": ["planned", "active", "paused", "completed", "abandoned"] },
        "configuration": true
      },
      "additionalProperties": false
    },
    "programPlanningState": {
      "type": "object",
      "required": ["schemaVersion", "instanceId", "definition", "revision", "blockIndex", "microcycleIndex", "sessionCursor", "completedOccurrenceCount"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "instanceId": { "$ref": "#/$defs/identifier" },
        "definition": { "$ref": "#/$defs/programDefinitionReference" },
        "revision": { "type": "integer", "minimum": 0 },
        "blockIndex": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "microcycleIndex": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "sessionCursor": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "completedOccurrenceCount": { "type": "integer", "minimum": 0 },
        "completed": { "type": "boolean" },
        "strategyState": { "$ref": "#/$defs/programState" }
      },
      "additionalProperties": false
    },
    "programOccurrenceRecord": {
      "type": "object",
      "required": ["schemaVersion", "instanceId", "definition", "blockId", "roleId", "occurrenceId", "status", "beforeRevision", "afterRevision"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "instanceId": { "$ref": "#/$defs/identifier" },
        "definition": { "$ref": "#/$defs/programDefinitionReference" },
        "blockId": { "$ref": "#/$defs/identifier" },
        "roleId": { "$ref": "#/$defs/identifier" },
        "occurrenceId": { "$ref": "#/$defs/identifier" },
        "scheduledDate": { "type": "string", "format": "date" },
        "scheduleStatus": { "enum": ["upcoming", "due", "overdue", "completed", "skipped", "partial", "abandoned"] },
        "status": { "enum": ["upcoming", "due", "overdue", "completed", "skipped", "partial", "abandoned"] },
        "beforeRevision": { "type": "integer", "minimum": 0 },
        "afterRevision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "plannedSessionIntentDocument": {
      "type": "object",
      "required": ["schemaVersion", "instanceId", "definition", "blockId", "roleId", "occurrenceId", "planningStateRevision", "program"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "instanceId": { "$ref": "#/$defs/identifier" },
        "definition": { "$ref": "#/$defs/programDefinitionReference" },
        "blockId": { "$ref": "#/$defs/identifier" },
        "roleId": { "$ref": "#/$defs/identifier" },
        "occurrenceId": { "$ref": "#/$defs/identifier" },
        "planningStateRevision": { "type": "integer", "minimum": 0 },
        "program": { "$ref": "#/$defs/programPlan" }
      },
      "additionalProperties": false
    },
    "programDefinitionValidationRequest": {
      "type": "object",
      "required": ["schemaVersion", "definition"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "definition": { "$ref": "#/$defs/programDefinitionDocument" }
      },
      "additionalProperties": false
    },
    "programDefinitionValidationResult": {
      "type": "object",
      "required": ["schemaVersion", "valid", "issues"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "valid": { "type": "boolean" },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
      },
      "additionalProperties": false
    },
    "programInstantiationRequest": {
      "type": "object",
      "required": ["schemaVersion", "definition", "instanceId", "athleteId", "configuration"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "definition": { "$ref": "#/$defs/programDefinitionDocument" },
        "instanceId": { "$ref": "#/$defs/identifier" },
        "athleteId": { "$ref": "#/$defs/identifier" },
        "startedOn": { "type": "string", "format": "date" },
        "lifecycle": { "enum": ["planned", "active", "paused", "completed", "abandoned"] },
        "configuration": true,
        "strategyState": { "$ref": "#/$defs/programState" }
      },
      "additionalProperties": false
    },
    "programInstantiationResult": {
      "type": "object",
      "required": ["schemaVersion", "instance", "state"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "instance": { "$ref": "#/$defs/programInstanceDocument" },
        "state": { "$ref": "#/$defs/programPlanningState" }
      },
      "additionalProperties": false
    },
    "programResolutionRequest": {
      "type": "object",
      "required": ["schemaVersion", "definition", "instance", "state"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "definition": { "$ref": "#/$defs/programDefinitionDocument" },
        "instance": { "$ref": "#/$defs/programInstanceDocument" },
        "state": { "$ref": "#/$defs/programPlanningState" },
        "localDate": {
          "type": "object",
          "required": ["isoDate", "weekday"],
          "properties": {
            "isoDate": { "type": "string", "format": "date" },
            "weekday": { "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] }
          },
          "additionalProperties": false
        },
        "catalog": { "type": "array", "items": { "$ref": "#/$defs/exercise" } }
      },
      "additionalProperties": false
    },
    "programAdvancementRequest": {
      "type": "object",
      "required": ["schemaVersion", "definition", "instance", "state", "intent", "status"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "definition": { "$ref": "#/$defs/programDefinitionDocument" },
        "instance": { "$ref": "#/$defs/programInstanceDocument" },
        "state": { "$ref": "#/$defs/programPlanningState" },
        "intent": { "$ref": "#/$defs/plannedSessionIntentDocument" },
        "status": { "enum": ["completed", "skipped"] },
        "nextStrategyState": { "$ref": "#/$defs/programState" }
      },
      "additionalProperties": false
    },
    "programStateProposalDocument": {
      "type": "object",
      "required": ["schemaVersion", "instanceId", "definition", "expectedRevision", "nextState", "occurrence"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "instanceId": { "$ref": "#/$defs/identifier" },
        "definition": { "$ref": "#/$defs/programDefinitionReference" },
        "expectedRevision": { "type": "integer", "minimum": 0 },
        "nextState": { "$ref": "#/$defs/programPlanningState" },
        "occurrence": { "$ref": "#/$defs/programOccurrenceRecord" }
      },
      "additionalProperties": false
    },
    "requestCommon": {
      "type": "object",
      "required": ["schemaVersion", "asOf", "methodology", "catalog"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "asOf": { "$ref": "#/$defs/timestamp" },
        "methodology": { "$ref": "#/$defs/methodologyRef" },
        "methodologyState": { "$ref": "#/$defs/methodologyState" },
        "catalog": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/exercise" }
        },
        "athleteProfile": { "$ref": "#/$defs/athleteProfile" },
        "history": { "$ref": "#/$defs/history" }
      }
    },
    "recommendationRequest": {
      "title": "RecommendationRequest",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/requestCommon" },
        {
          "type": "object",
          "properties": {
            "trainingContext": { "$ref": "#/$defs/trainingContext" },
            "alternativeLimit": { "type": "integer", "minimum": 0, "maximum": 100 },
            "tieBreakSeed": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "evaluationRequest": {
      "title": "EvaluationRequest",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/requestCommon" },
        {
          "type": "object",
          "required": ["completedWorkout"],
          "properties": {
            "completedWorkout": { "$ref": "#/$defs/completedWorkout" }
          }
        }
      ]
    },
    "issue": {
      "type": "object",
      "required": ["code", "path", "message", "severity"],
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "path": { "$ref": "#/$defs/jsonPointer" },
        "message": { "type": "string" },
        "severity": { "enum": ["info", "warning", "error"] },
        "parameters": { "$ref": "#/$defs/openObject" },
        "suggestion": { "type": "string" }
      },
      "additionalProperties": false
    },
    "explanation": {
      "type": "object",
      "required": ["id", "code", "category", "summary", "severity"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "code": { "$ref": "#/$defs/code" },
        "category": { "$ref": "#/$defs/identifier" },
        "summary": { "type": "string" },
        "subject": {
          "type": "object",
          "properties": {
            "exerciseId": { "$ref": "#/$defs/identifier" },
            "setIndex": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": { "path": { "$ref": "#/$defs/jsonPointer" } },
            "additionalProperties": false
          }
        },
        "parameters": { "$ref": "#/$defs/openObject" },
        "ruleId": { "$ref": "#/$defs/identifier" },
        "severity": { "enum": ["info", "warning", "error"] }
      },
      "additionalProperties": false
    },
    "setRecommendation": {
      "type": "object",
      "required": ["kind", "targetMetrics"],
      "properties": {
        "kind": { "$ref": "#/$defs/identifier" },
        "targetMetrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
        "restDuration": { "$ref": "#/$defs/measurement" },
        "explanationRefs": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
      },
      "additionalProperties": false
    },
    "exerciseRecommendation": {
      "type": "object",
      "required": ["exerciseId", "sets"],
      "properties": {
        "exerciseId": { "$ref": "#/$defs/identifier" },
        "sets": { "type": "array", "items": { "$ref": "#/$defs/setRecommendation" } },
        "substitutionGroup": { "$ref": "#/$defs/identifier" },
        "explanationRefs": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
      },
      "additionalProperties": false
    },
    "sessionRecommendation": {
      "type": "object",
      "required": ["exercises"],
      "properties": {
        "title": { "type": "string" },
        "estimatedDuration": { "$ref": "#/$defs/measurement" },
        "exercises": { "type": "array", "items": { "$ref": "#/$defs/exerciseRecommendation" } },
        "resolvedTrainingContext": { "type": "object" }
      },
      "additionalProperties": false
    },
    "performanceEvaluation": {
      "type": "object",
      "required": ["outcome", "exercises"],
      "properties": {
        "outcome": { "$ref": "#/$defs/identifier" },
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["exerciseId", "outcome"],
            "properties": {
              "exerciseId": { "$ref": "#/$defs/identifier" },
              "outcome": { "$ref": "#/$defs/identifier" },
              "explanationRefs": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["engineVersion", "schemaVersion", "methodology", "inputFingerprint", "resultFingerprint"],
      "properties": {
        "engineVersion": { "type": "string" },
        "schemaVersion": { "const": 1 },
        "methodology": {
          "type": "object",
          "required": ["id", "version", "configVersion"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "version": { "type": "string" },
            "configVersion": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "inputFingerprint": { "type": "string", "minLength": 1 },
        "resultFingerprint": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "resultCommon": {
      "type": "object",
      "required": ["ok", "metadata"],
      "properties": {
        "ok": { "type": "boolean" },
        "nextMethodologyState": { "$ref": "#/$defs/methodologyState" },
        "explanations": { "type": "array", "items": { "$ref": "#/$defs/explanation" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "recommendationResult": {
      "title": "RecommendationResult",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/resultCommon" },
        {
          "type": "object",
          "properties": {
            "recommendation": { "$ref": "#/$defs/sessionRecommendation" },
            "alternatives": { "type": "array", "items": { "$ref": "#/$defs/sessionRecommendation" } }
          }
        }
      ]
    },
    "evaluationResult": {
      "title": "EvaluationResult",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/resultCommon" },
        {
          "type": "object",
          "properties": {
            "evaluation": { "$ref": "#/$defs/performanceEvaluation" }
          }
        }
      ]
    }
  }
}
