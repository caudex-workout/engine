{
  "name": "Caudex development",
  "build": {"dockerfile": "Dockerfile"},
  "remoteUser": "vscode",
  "postCreateCommand": "./tools/dev/doctor",
  "forwardPorts": [8080],
  "customizations": {
    "vscode": {
      "extensions": ["ziglang.vscode-zig", "ms-vscode.cpptools"],
      "settings": {
        "zig.path": "/opt/zig/zig"
      }
    }
  }
}
