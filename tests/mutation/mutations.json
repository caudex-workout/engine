[
  {"id":"dp_success_threshold","file":"src/double_progression.zig","category":"comparison","original":"evidence.successful_sets >= resolved.advancementCriteria.minimumSuccessfulSets","replacement":"evidence.successful_sets > resolved.advancementCriteria.minimumSuccessfulSets","test":"double_progression"},
  {"id":"dp_minimum_rep_threshold","file":"src/double_progression.zig","category":"comparison","original":"evidence.target_repetitions >=\n            resolved.advancementCriteria.minimumRepetitions","replacement":"evidence.target_repetitions >\n            resolved.advancementCriteria.minimumRepetitions","test":"double_progression"},
  {"id":"dp_session_cap","file":"src/double_progression.zig","category":"comparison","original":"limit < recommendation.working_sets","replacement":"limit <= recommendation.working_sets","test":"double_progression"},
  {"id":"dp_completed_set_guard","file":"src/double_progression.zig","category":"comparison","original":"working_set_count == 0 or load == null","replacement":"working_set_count != 0 or load == null","test":"double_progression"},
  {"id":"dp_repetition_advance","file":"src/double_progression.zig","category":"comparison","original":"repetitions >= target","replacement":"repetitions > target","test":"double_progression"},
  {"id":"dp_min_rep_zero","file":"src/double_progression.zig","category":"boundary","original":"rep_range.min == 0","replacement":"rep_range.min != 0","test":"double_progression"},
  {"id":"dp_set_limit","file":"src/double_progression.zig","category":"boundary","original":"working_sets > 64","replacement":"working_sets >= 64","test":"double_progression"},
  {"id":"dp_minimum_reps","file":"src/double_progression.zig","category":"comparison","original":"advancement.minimumRepetitions < rep_range.min","replacement":"advancement.minimumRepetitions <= rep_range.min","test":"double_progression"},
  {"id":"dp_positive_measurement","file":"src/double_progression.zig","category":"comparison","original":"value.mantissa <= 0","replacement":"value.mantissa < 0","test":"double_progression"},
  {"id":"dp_regression_direction","file":"src/double_progression.zig","category":"comparison","original":"decimalGreaterThan(regression.value, load.value)","replacement":"!decimalGreaterThan(regression.value, load.value)","test":"double_progression"},
  {"id":"rpe_overshoot_boundary","file":"src/rpe_top_set_backoff.zig","category":"comparison","original":"compareDecimal(actual_rpe, upper) == .gt","replacement":"compareDecimal(actual_rpe, upper) != .gt","test":"rpe_top_set_backoff"},
  {"id":"rpe_undershoot_boundary","file":"src/rpe_top_set_backoff.zig","category":"comparison","original":"compareDecimal(actual_rpe, lower) == .lt","replacement":"compareDecimal(actual_rpe, lower) != .lt","test":"rpe_top_set_backoff"},
  {"id":"rpe_conflicting_exertion","file":"src/rpe_top_set_backoff.zig","category":"boolean","original":"rpe_metric != null and rir_metric != null","replacement":"rpe_metric != null or rir_metric != null","test":"rpe_top_set_backoff"},
  {"id":"rpe_missing_exertion","file":"src/rpe_top_set_backoff.zig","category":"boolean","original":"rpe_metric == null and rir_metric == null","replacement":"rpe_metric == null or rir_metric == null","test":"rpe_top_set_backoff"},
  {"id":"rpe_unit_guard","file":"src/rpe_top_set_backoff.zig","category":"boolean","original":"fn effectiveRepetitionsFromRpe(\n    repetitions: u16,\n    measurement: primitives.Measurement,\n) RecommendationError!primitives.Decimal {\n    if (measurement.unit != .rpe or\n        !decimalBetween(measurement.value, 1, 10))","replacement":"fn effectiveRepetitionsFromRpe(\n    repetitions: u16,\n    measurement: primitives.Measurement,\n) RecommendationError!primitives.Decimal {\n    if (measurement.unit != .rpe and\n        !decimalBetween(measurement.value, 1, 10))","test":"rpe_top_set_backoff"},
  {"id":"rpe_denominator_boundary","file":"src/rpe_top_set_backoff.zig","category":"boundary","original":"fn divideRoundHalfAwayFromZero(\n    numerator: i128,\n    denominator: i128,\n) RecommendationError!i128 {\n    if (denominator <= 0)","replacement":"fn divideRoundHalfAwayFromZero(\n    numerator: i128,\n    denominator: i128,\n) RecommendationError!i128 {\n    if (denominator < 0)","test":"rpe_top_set_backoff"},
  {"id":"rpe_round_half","file":"src/rpe_top_set_backoff.zig","category":"rounding","original":"magnitude * 2 < denominator","replacement":"magnitude * 2 <= denominator","test":"rpe_top_set_backoff"},
  {"id":"rpe_scale_branch","file":"src/rpe_top_set_backoff.zig","category":"comparison","original":"value.scale == 3","replacement":"value.scale != 3","test":"rpe_top_set_backoff"},
  {"id":"rpe_factor_sign","file":"src/rpe_top_set_backoff.zig","category":"comparison","original":"factor < 0","replacement":"factor <= 0","test":"rpe_top_set_backoff"},
  {"id":"rpe_estimate_overflow","file":"src/rpe_top_set_backoff.zig","category":"comparison","original":"estimate < 0 or estimate > std.math.maxInt(i64)","replacement":"estimate <= 0 or estimate > std.math.maxInt(i64)","test":"rpe_top_set_backoff"},
  {"id":"rpe_tolerance_upper","file":"src/rpe_top_set_backoff.zig","category":"comparison","original":"compareDecimal(value, min) != .lt and compareDecimal(value, max) != .gt","replacement":"compareDecimal(value, min) != .lt and compareDecimal(value, max) == .gt","test":"rpe_top_set_backoff"}
]
